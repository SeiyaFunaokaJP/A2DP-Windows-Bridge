{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A2DP Windows Bridge",
  "mainBinaryName": "a2dpwb",
  "identifier": "io.github.seiyafunaokajp.a2dpwb",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"],
    "publisher": "Seiya Funaoka",
    "copyright": "Copyright (c) Seiya Funaoka. Apache-2.0 OR MIT.",
    "homepage": "https://github.com/SeiyaFunaokaJP/A2DP-Windows-Bridge",
    "license": "Apache-2.0 OR MIT",
    "licenseFile": "../../../../LICENSE",
    "category": "Utility",
    "shortDescription": "Bluetooth A2DP audio from Windows through a USB Bluetooth adapter"
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": { "installMode": "basicUi" }
    }
  }
}
